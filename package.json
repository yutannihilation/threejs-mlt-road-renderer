{
  "name": "threejs-mlt-road-renderer",
  "version": "0.0.0",
  "description": "A MapLibre custom layer that draws 3D road centrelines from MLT tiles as flat ribbons with Three.js",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build",
    "build:lib": "vp build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vp preview",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@maplibre/mlt-wasm": "file:../maplibre-tile-spec/rust/mlt-wasm",
    "@types/node": "^24.19.0",
    "@types/three": "0.186.0",
    "maplibre-gl": "5.24.0",
    "three": "0.186.1",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@maplibre/mlt-wasm": "*",
    "maplibre-gl": ">=5",
    "three": ">=0.170"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  }
}
